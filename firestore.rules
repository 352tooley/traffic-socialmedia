rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user profile
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is DM
    function isDM() {
      return isAuthenticated() && getUserProfile().role == 'dm';
    }

    // Helper function to check if user belongs to a store
    function isStoreUser(storeName) {
      return isAuthenticated() && getUserProfile().storeName == storeName;
    }

    // Users collection rules
    match /users/{userId} {
      // Users can read their own profile
      // DM can read all user profiles
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isDM());

      // Only allow writes through admin SDK (Firebase Console or Cloud Functions)
      // This prevents unauthorized user creation/modification
      allow write: if false;
    }

    // Submissions collection rules
    match /submissions/{submissionId} {
      // Store users can read submissions for their own store
      // DM can read all submissions
      allow read: if isAuthenticated() &&
        (isDM() || isStoreUser(resource.data.storeName));

      // Store users can create submissions for their own store
      // DM can create submissions for any store
      allow create: if isAuthenticated() &&
        (isDM() || isStoreUser(request.resource.data.storeName));

      // Store users can update their own store's submissions
      // DM can update any submission
      allow update: if isAuthenticated() &&
        (isDM() || isStoreUser(resource.data.storeName));

      // Only DM can delete submissions
      allow delete: if isDM();
    }
  }
}
